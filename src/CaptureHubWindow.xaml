<Window x:Class="WinSnipper.CaptureHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attach to ADE" Width="560" Height="420" MinWidth="480" MinHeight="400"
        Background="{StaticResource Ws.Chrome}" Foreground="{StaticResource Ws.Text}"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Ws.Text}"/>
            <Setter Property="Background" Value="{StaticResource Ws.Canvas}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Ws.Rule}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource Ws.Canvas}" BorderBrush="{StaticResource Ws.Rule}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                            <Grid><Path Data="M0,0 L4,4 L8,0" Width="8" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" Stroke="{StaticResource Ws.TextDim}" StrokeThickness="1.5"/></Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock Margin="12,8,30,8" IsHitTestVisible="False" Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource Ws.Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="{StaticResource Ws.Popup}" BorderBrush="{StaticResource Ws.Rule}" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ws.Text}"/>
            <Setter Property="Background" Value="{StaticResource Ws.Popup}"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root" Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Attach to an ADE draft" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="CaptureName" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Ws.TextDim}" Margin="0,10,0,16"/>
        </StackPanel>
        <ComboBox Grid.Row="1" x:Name="Destinations" DisplayMemberPath="Label" MinHeight="34" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="2" x:Name="Status" Text="Loading destinations…" TextWrapping="Wrap" Foreground="{StaticResource Ws.TextDim}" Margin="0,0,0,16"/>
        <ListBox Grid.Row="3" x:Name="Saved" Background="{StaticResource Ws.Canvas}" Foreground="{StaticResource Ws.Text}" BorderThickness="0" DisplayMemberPath="Destination.Label" MaxHeight="140"/>
        <WrapPanel Grid.Row="4" Margin="0,18,0,0">
            <Button x:Name="AttachButton" Content="Add screenshot" Click="Attach_Click" Style="{StaticResource Ws.BtnAccent}" Margin="0,0,8,8"/>
            <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource Ws.BtnOutline}" Margin="0,0,8,8"/>
            <Button x:Name="RetryButton" Content="Retry saved" Click="Retry_Click" Style="{StaticResource Ws.BtnOutline}" Margin="0,0,0,8"/>
        </WrapPanel>
    </Grid>
</Window>
