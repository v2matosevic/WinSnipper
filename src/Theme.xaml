<!--
    Shared look for the editing windows (screenshot editor + trim).
    Icons are stroke geometries on a 24-unit grid, drawn by the Icon style at
    18 DIP, so they stay crisp at any scale and never depend on which symbol
    font a Windows install happens to have.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== palette ========== -->
    <SolidColorBrush x:Key="Ws.Chrome" Color="#FF1F2024"/>
    <SolidColorBrush x:Key="Ws.Canvas" Color="#FF141518"/>
    <SolidColorBrush x:Key="Ws.Group" Color="#FF292A30"/>
    <SolidColorBrush x:Key="Ws.Popup" Color="#FF26272D"/>
    <SolidColorBrush x:Key="Ws.Hover" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="Ws.Pressed" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="Ws.Rule" Color="#FF303238"/>
    <SolidColorBrush x:Key="Ws.Edge" Color="#FF0E0F11"/>
    <SolidColorBrush x:Key="Ws.Hairline" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="Ws.Text" Color="#FFECEDEF"/>
    <SolidColorBrush x:Key="Ws.TextDim" Color="#FF9DA2AB"/>
    <SolidColorBrush x:Key="Ws.TextFaint" Color="#FF6C717A"/>
    <SolidColorBrush x:Key="Ws.Accent" Color="#FF3478F6"/>
    <SolidColorBrush x:Key="Ws.AccentHover" Color="#FF4A88F8"/>
    <SolidColorBrush x:Key="Ws.AccentPressed" Color="#FF2B69DE"/>
    <SolidColorBrush x:Key="Ws.Danger" Color="#FFE5484D"/>

    <FontFamily x:Key="Ws.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Ws.Glyphs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ========== icons (24-unit grid, 2-unit round strokes) ========== -->
    <Geometry x:Key="Ico.Rect">M6,5.5 H18 A2.5,2.5 0 0 1 20.5,8 V16 A2.5,2.5 0 0 1 18,18.5 H6 A2.5,2.5 0 0 1 3.5,16 V8 A2.5,2.5 0 0 1 6,5.5 Z</Geometry>
    <Geometry x:Key="Ico.Ellipse">M3.5,12 A8.5,6.8 0 1 1 20.5,12 A8.5,6.8 0 1 1 3.5,12 Z</Geometry>
    <Geometry x:Key="Ico.Arrow">M5.5,18.5 L18,6 M9,6 H18 V15</Geometry>
    <Geometry x:Key="Ico.Pen">M15.2,4.8 A2.3,2.3 0 0 1 19.2,8.8 L8.6,19.4 L4,20 L4.6,15.4 Z M13.4,6.6 L17.4,10.6</Geometry>
    <Geometry x:Key="Ico.Text">M5,7.5 V5 H19 V7.5 M12,5 V19 M9,19 H15</Geometry>
    <Geometry x:Key="Ico.Step">M3.5,12 A8.5,8.5 0 1 1 20.5,12 A8.5,8.5 0 1 1 3.5,12 Z M10.2,9.6 L12.6,8 V16</Geometry>
    <Geometry x:Key="Ico.Redact">M5,5 H7 V7 H5 Z M13,5 H15 V7 H13 Z M9,9 H11 V11 H9 Z M17,9 H19 V11 H17 Z M5,13 H7 V15 H5 Z M13,13 H15 V15 H13 Z M9,17 H11 V19 H9 Z M17,17 H19 V19 H17 Z</Geometry>
    <Geometry x:Key="Ico.Crop">M7,3 V15 A2,2 0 0 0 9,17 H21 M3,7 H15 A2,2 0 0 1 17,9 V21</Geometry>
    <Geometry x:Key="Ico.Undo">M9,14 L4,9 L9,4 M4,9 H14.5 A5.5,5.5 0 0 1 14.5,20 H11</Geometry>
    <Geometry x:Key="Ico.Redo">M15,14 L20,9 L15,4 M20,9 H9.5 A5.5,5.5 0 0 0 9.5,20 H13</Geometry>
    <Geometry x:Key="Ico.Save">M6,4 H15.5 L20,8.5 V18 A2,2 0 0 1 18,20 H6 A2,2 0 0 1 4,18 V6 A2,2 0 0 1 6,4 Z M7.5,20 V14.5 H16.5 V20 M8,4 V8 H13.5</Geometry>
    <Geometry x:Key="Ico.SaveAs">M3.5,7 A2,2 0 0 1 5.5,5 H9.4 L11.4,7 H18.5 A2,2 0 0 1 20.5,9 V17 A2,2 0 0 1 18.5,19 H5.5 A2,2 0 0 1 3.5,17 Z M12,10.5 V15.5 M9.5,13 H14.5</Geometry>
    <Geometry x:Key="Ico.ScanText">M4,8 V6 A2,2 0 0 1 6,4 H8 M16,4 H18 A2,2 0 0 1 20,6 V8 M20,16 V18 A2,2 0 0 1 18,20 H16 M8,20 H6 A2,2 0 0 1 4,18 V16 M8,9.5 H16 M8,12.5 H16 M8,15.5 H12.5</Geometry>
    <Geometry x:Key="Ico.Copy">M10,9 H18 A2,2 0 0 1 20,11 V18 A2,2 0 0 1 18,20 H11 A2,2 0 0 1 9,18 V10 A1,1 0 0 1 10,9 Z M15,9 V6 A2,2 0 0 0 13,4 H6 A2,2 0 0 0 4,6 V13 A2,2 0 0 0 6,15 H9</Geometry>
    <Geometry x:Key="Ico.Check">M5,12.5 L10,17.5 L19,7</Geometry>
    <Geometry x:Key="Ico.Close">M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5</Geometry>
    <Geometry x:Key="Ico.Minus">M6,12 H18</Geometry>
    <Geometry x:Key="Ico.Plus">M12,6 V18 M6,12 H18</Geometry>
    <Geometry x:Key="Ico.Fit">M4,9 V6 A2,2 0 0 1 6,4 H9 M15,4 H18 A2,2 0 0 1 20,6 V9 M20,15 V18 A2,2 0 0 1 18,20 H15 M9,20 H6 A2,2 0 0 1 4,18 V15</Geometry>
    <Geometry x:Key="Ico.Chevron">M8,10 L12,14 L16,10</Geometry>
    <Geometry x:Key="Ico.Play">M8,5.2 L19,12 L8,18.8 Z</Geometry>
    <Geometry x:Key="Ico.Pause">M7,5 H10 V19 H7 Z M14,5 H17 V19 H14 Z</Geometry>
    <Geometry x:Key="Ico.Scissors">M6,9 A3,3 0 1 1 6,3 A3,3 0 1 1 6,9 Z M6,21 A3,3 0 1 1 6,15 A3,3 0 1 1 6,21 Z M8.1,8.1 L20,20 M8.1,15.9 L20,4</Geometry>

    <!-- Stroke icon: Content is a Geometry, colour follows Foreground. -->
    <Style x:Key="Icon" TargetType="ContentControl">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Solid icon (play / pause). -->
    <Style x:Key="IconFill" TargetType="ContentControl" BasedOn="{StaticResource Icon}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                  Fill="{TemplateBinding Foreground}" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== buttons ========== -->

    <!-- Tool in the segmented tool group; Content = icon geometry. -->
    <Style x:Key="Ws.Tool" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Ws.TextDim}"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="B" Background="Transparent" CornerRadius="6">
                        <ContentControl Style="{StaticResource Icon}" Content="{TemplateBinding Content}"
                                        Width="Auto" Height="Auto" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Ws.Hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Ws.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Ws.Accent}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon-only button; Content = icon geometry. -->
    <Style x:Key="Ws.IconBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ws.TextDim}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentControl Style="{StaticResource Icon}" Content="{TemplateBinding Content}"
                                        Width="Auto" Height="Auto" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Ws.Hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Ws.Text}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Ws.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text button with an optional leading icon in Tag. -->
    <Style x:Key="Ws.Btn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ws.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="11,0,13,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentControl x:Name="Ico" Style="{StaticResource Icon}" Width="16" Height="16"
                                            Content="{TemplateBinding Tag}" Margin="0,0,7,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Ico" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Ws.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Ws.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Outlined secondary (used where a ghost button would float too freely). -->
    <Style x:Key="Ws.BtnOutline" TargetType="Button" BasedOn="{StaticResource Ws.Btn}">
        <Setter Property="Background" Value="{StaticResource Ws.Group}"/>
        <Setter Property="BorderBrush" Value="#14FFFFFF"/>
    </Style>

    <Style x:Key="Ws.BtnAccent" TargetType="Button" BasedOn="{StaticResource Ws.Btn}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{StaticResource Ws.Accent}" CornerRadius="6"
                            BorderBrush="#26FFFFFF" BorderThickness="0,1,0,0"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentControl x:Name="Ico" Style="{StaticResource Icon}" Width="16" Height="16"
                                            Content="{TemplateBinding Tag}" Margin="0,0,7,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Ico" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Ws.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Ws.AccentPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Windows 11 caption buttons: flush, 46 wide, glyphs from the system icon font. -->
    <Style x:Key="Ws.Caption" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ws.TextDim}"/>
        <Setter Property="FontFamily" Value="{StaticResource Ws.Glyphs}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#14FFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource Ws.Text}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#0AFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ws.CaptionMax" TargetType="Button" BasedOn="{StaticResource Ws.Caption}">
        <Setter Property="Content" Value="&#xE922;"/>
        <Setter Property="ToolTip" Value="Maximize"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                <Setter Property="Content" Value="&#xE923;"/>
                <Setter Property="ToolTip" Value="Restore"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Ws.CaptionClose" TargetType="Button" BasedOn="{StaticResource Ws.Caption}">
        <Setter Property="Content" Value="&#xE8BB;"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#FFC42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#FFB0281A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== small controls ========== -->

    <Style x:Key="Ws.Divider" TargetType="Rectangle">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Fill" Value="{StaticResource Ws.Rule}"/>
        <Setter Property="Margin" Value="8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- A keyboard key, for shortcut hints. -->
    <Style x:Key="Ws.Key" TargetType="Border">
        <Setter Property="Background" Value="#FF2A2B31"/>
        <Setter Property="BorderBrush" Value="#FF3A3C43"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="5,0,5,1"/>
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextElement.FontSize" Value="11"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Ws.TextDim}"/>
    </Style>

    <Style x:Key="Ws.ToolTip" TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource Ws.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Ws.Font}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#FF2B2C32" BorderBrush="#FF3C3E46" BorderThickness="1"
                            CornerRadius="6" Padding="9,5" Margin="0,0,0,2">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ws.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Background="#40FFFFFF" CornerRadius="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#66FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#80FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ws.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ws.ScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}" Padding="2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Ws.ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Ws.ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Ws.ScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}" Padding="2">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Ws.ScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Ws.ScrollPage}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Ws.ScrollThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Ws.CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Ws.TextDim}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" VerticalAlignment="Center"
                                Background="#FF232429" BorderBrush="#FF4A4D56" BorderThickness="1">
                            <Path x:Name="Mark" Data="M4,9.2 L7.4,12.4 L14,5.6" Stroke="White" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" Margin="-1,-1,0,0"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,1"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#FF6A6E78"/>
                            <Setter Property="Foreground" Value="{StaticResource Ws.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Ws.Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ws.Accent}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource Ws.Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ws.Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="#1FFFFFFF" CornerRadius="1.5"/>
                        <Border x:Name="PART_Indicator" Background="{StaticResource Ws.Accent}" CornerRadius="1.5"
                                HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded flyout surface for popups. -->
    <Style x:Key="Ws.Flyout" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Ws.Popup}"/>
        <Setter Property="BorderBrush" Value="#FF393B43"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="12,6,12,16"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.5" Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
