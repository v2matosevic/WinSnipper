<Window x:Class="WinSnipper.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinSnipper — Trim recording"
        Background="{StaticResource Ws.Chrome}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Width="920" Height="660"
        MinWidth="620" MinHeight="460"
        FontFamily="{StaticResource Ws.Font}"
        TextOptions.TextFormattingMode="Display"
        ShowInTaskbar="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="ToolTip" BasedOn="{StaticResource Ws.ToolTip}"/>

        <Style x:Key="PlayBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ws.Text}"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{StaticResource Ws.Group}" CornerRadius="8"
                                BorderBrush="#14FFFFFF" BorderThickness="1">
                            <ContentControl Style="{StaticResource IconFill}" Content="{TemplateBinding Content}"
                                            Width="20" Height="20"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#FF34353C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#FF2D2E34"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain Segoe UI: its digits are fixed-width, Segoe UI Variable's are not,
             and a ticking time readout must not wobble. -->
        <Style x:Key="Readout" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource Ws.TextDim}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Ws.TextFaint}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3,0,16,0"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- title bar -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="16,0,160,0" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{StaticResource Ws.Danger}" VerticalAlignment="Center"/>
                <TextBlock Text="Trim" Foreground="{StaticResource Ws.Text}" FontSize="13" FontWeight="SemiBold"
                           Margin="9,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Foreground="{StaticResource Ws.TextDim}" FontSize="13"
                           Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Ws.Caption}" Content="&#xE921;" ToolTip="Minimize"
                        Command="{x:Static SystemCommands.MinimizeWindowCommand}"/>
                <Button Style="{StaticResource Ws.CaptionMax}"
                        Command="{x:Static SystemCommands.MaximizeWindowCommand}"/>
                <Button Style="{StaticResource Ws.CaptionClose}" ToolTip="Close"
                        Command="{x:Static SystemCommands.CloseWindowCommand}"/>
            </StackPanel>
        </Grid>

        <!-- player: click anywhere to play / pause -->
        <Border x:Name="PlayerFrame" Grid.Row="1" Margin="16,0,16,0" Background="Black" CornerRadius="10"
                Cursor="Hand" MouseLeftButtonUp="Player_Click" SizeChanged="PlayerFrame_SizeChanged"
                MouseEnter="PlayerFrame_Hover" MouseLeave="PlayerFrame_Hover">
            <Grid x:Name="PlayerInner">
                <MediaElement x:Name="Player"
                              LoadedBehavior="Manual" UnloadedBehavior="Manual"
                              ScrubbingEnabled="True" Stretch="Uniform"
                              MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"
                              MediaFailed="Player_MediaFailed"/>
                <Border x:Name="PlayOverlay" Width="64" Height="64" CornerRadius="32" IsHitTestVisible="False"
                        Background="#99000000" BorderBrush="#40FFFFFF" BorderThickness="1">
                    <ContentControl Style="{StaticResource IconFill}" Content="{StaticResource Ico.Play}"
                                    Foreground="White" Width="26" Height="26" Margin="4,0,0,0"/>
                </Border>
                <Border x:Name="ErrorOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                        Background="#E61A1B1F" CornerRadius="8" Padding="16,10" MaxWidth="460"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="ErrorOverlayText" Foreground="{StaticResource Ws.Text}" FontSize="13"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="16,0,16,0" CornerRadius="10" IsHitTestVisible="False"
                BorderBrush="{StaticResource Ws.Hairline}" BorderThickness="1"/>

        <!-- transport: play button + filmstrip, readouts underneath -->
        <Grid Grid.Row="2" Margin="16,14,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button x:Name="PlayBtn" Style="{StaticResource PlayBtn}" Content="{StaticResource Ico.Play}"
                    Click="Play_Click" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Play / pause  (Space)"/>

            <!-- The grab area is taller than the strip so the playhead knob and the
                 handle edges are easy to catch. -->
            <Grid x:Name="TimelineArea" Grid.Column="1" Height="64" Background="Transparent"
                  MouseLeftButtonDown="Timeline_MouseDown"
                  MouseMove="Timeline_MouseMove"
                  MouseLeftButtonUp="Timeline_MouseUp">
                <Border x:Name="TimelineHost" Height="52" VerticalAlignment="Center" CornerRadius="8"
                        Background="#FF101114" SizeChanged="Timeline_SizeChanged">
                    <Grid x:Name="TimelineInner">
                        <StackPanel x:Name="FilmStrip" Orientation="Horizontal" IsHitTestVisible="False"
                                    RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Canvas IsHitTestVisible="False">
                            <Rectangle x:Name="DimL" Fill="#B30C0D10"/>
                            <Rectangle x:Name="DimR" Fill="#B30C0D10"/>
                        </Canvas>
                    </Grid>
                </Border>
                <Canvas x:Name="TL" IsHitTestVisible="False">
                    <Border x:Name="SelFrame" BorderBrush="{StaticResource Ws.Accent}" BorderThickness="0,3,0,3"/>
                    <Border x:Name="HandleL" Width="14" Background="{StaticResource Ws.Accent}" CornerRadius="8,0,0,8">
                        <Rectangle Width="2.5" Height="18" Fill="#F2FFFFFF" RadiusX="1.25" RadiusY="1.25"/>
                    </Border>
                    <Border x:Name="HandleR" Width="14" Background="{StaticResource Ws.Accent}" CornerRadius="0,8,8,0">
                        <Rectangle Width="2.5" Height="18" Fill="#F2FFFFFF" RadiusX="1.25" RadiusY="1.25"/>
                    </Border>
                    <Rectangle x:Name="Playhead" Width="2" Fill="#FFF4F5F7" RadiusX="1" RadiusY="1">
                        <Rectangle.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.7" Color="#FF000000"/>
                        </Rectangle.Effect>
                    </Rectangle>
                    <Ellipse x:Name="PlayheadKnob" Width="10" Height="10" Fill="#FFF4F5F7"/>
                    <Border x:Name="TimeBadge" Background="#FF2B2C32" CornerRadius="6" Padding="8,3,8,4"
                            BorderBrush="#FF40424A" BorderThickness="1" Visibility="Collapsed">
                        <TextBlock x:Name="TimeBadgeText" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
                    </Border>
                </Canvas>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="1" Margin="2,6,2,0">
                <TextBlock x:Name="TimeLabel" Style="{StaticResource Readout}" HorizontalAlignment="Left">
                    <Run x:Name="TimeNow" Foreground="{StaticResource Ws.Text}" Text="0:00.0"/><Run Text="  /  "/><Run x:Name="TimeTotal" Text="0:00.0"/>
                </TextBlock>
                <TextBlock x:Name="RangeLabel" Style="{StaticResource Readout}" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Grid>

        <!-- footer: shortcuts (or the error) on the left, output on the right -->
        <Border Grid.Row="3" Margin="0,14,0,0" BorderBrush="{StaticResource Ws.Edge}" BorderThickness="0,1,0,0"
                Background="#FF1B1C20">
            <Grid>
                <ProgressBar x:Name="TrimProgress" Style="{StaticResource Ws.Progress}" VerticalAlignment="Top"
                             Height="2" Minimum="0" Maximum="1" Visibility="Collapsed"/>
                <Grid x:Name="Footer" Margin="16,12" SizeChanged="Footer_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="Hints" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Ws.Key}"><TextBlock Text="Space"/></Border>
                        <TextBlock Style="{StaticResource HintText}" Text="play"/>
                        <Border Style="{StaticResource Ws.Key}"><TextBlock Text="["/></Border>
                        <Border Style="{StaticResource Ws.Key}"><TextBlock Text="]"/></Border>
                        <TextBlock Style="{StaticResource HintText}" Text="set in / out"/>
                        <Border Style="{StaticResource Ws.Key}"><TextBlock Text="←"/></Border>
                        <Border Style="{StaticResource Ws.Key}"><TextBlock Text="→"/></Border>
                        <TextBlock Style="{StaticResource HintText}" Text="step"/>
                    </StackPanel>
                    <TextBlock x:Name="ErrorText" Foreground="#FFFF8A8E" FontSize="12.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="ReplaceCheck" Style="{StaticResource Ws.CheckBox}" Content="Replace original"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  ToolTip="Overwrite the recording instead of saving a “(trimmed)” copy next to it"/>
                        <Button x:Name="SaveAsBtn" Style="{StaticResource Ws.BtnOutline}" Content="Save as…"
                                MinWidth="92" Margin="0,0,8,0" Click="SaveTrimAs_Click"/>
                        <Button x:Name="SaveBtn" Style="{StaticResource Ws.BtnAccent}" Content="Save trimmed"
                                Tag="{StaticResource Ico.Scissors}" MinWidth="132" Click="SaveTrim_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
