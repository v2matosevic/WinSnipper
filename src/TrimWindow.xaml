<Window x:Class="WinSnipper.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinSnipper — Trim recording"
        Background="#FF1E1F24"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Width="880" Height="640"
        MinWidth="600" MinHeight="440"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        ShowInTaskbar="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="BarBg" Color="#FF24252B"/>
        <SolidColorBrush x:Key="GroupBg" Color="#FF2B2C33"/>
        <SolidColorBrush x:Key="BtnHover" Color="#FF3C3E48"/>
        <SolidColorBrush x:Key="AccentBg" Color="#FF3478F6"/>
        <SolidColorBrush x:Key="AccentHover" Color="#FF4A89F8"/>
        <SolidColorBrush x:Key="TextFg" Color="#FFE8EAEE"/>
        <SolidColorBrush x:Key="TextDim" Color="#FF9AA0A8"/>

        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextFg}"/>
            <Setter Property="Background" Value="{StaticResource GroupBg}"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource BtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Background" Value="{StaticResource AccentBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#E6D64545"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- title bar -->
        <Grid DockPanel.Dock="Top" Background="{StaticResource BarBg}" Height="42">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0">
                <Ellipse Width="10" Height="10" Fill="#FFE5484D" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Text="Trim recording" Foreground="{StaticResource TextFg}" FontSize="13"
                           FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Style="{StaticResource CaptionCloseBtn}" Content="✕" Click="Close_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
        </Grid>

        <!-- footer: filmstrip timeline + controls -->
        <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,14">
            <!-- timeline: filmstrip, dimmed outside the selection, draggable
                 in/out handles, playhead -->
            <Border x:Name="TimelineHost" Height="58" Margin="0,12,0,0" CornerRadius="7"
                    Background="#FF17181C" ClipToBounds="True" Cursor="Arrow"
                    MouseLeftButtonDown="Timeline_MouseDown"
                    MouseMove="Timeline_MouseMove"
                    MouseLeftButtonUp="Timeline_MouseUp"
                    SizeChanged="Timeline_SizeChanged">
                <Grid x:Name="TimelineInner">
                    <UniformGrid x:Name="FilmStrip" Rows="1" IsHitTestVisible="False"
                                 RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Canvas x:Name="TL" IsHitTestVisible="False">
                        <Rectangle x:Name="DimL" Fill="#8C0E0F12" Height="58"/>
                        <Rectangle x:Name="DimR" Fill="#8C0E0F12" Height="58"/>
                        <Border x:Name="SelFrame" BorderBrush="{StaticResource AccentBg}"
                                BorderThickness="2.5" CornerRadius="5" Height="58"/>
                        <Border x:Name="HandleL" Width="14" Height="58" Background="{StaticResource AccentBg}"
                                CornerRadius="5,0,0,5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Width="2" Height="18" Fill="#E6FFFFFF" RadiusX="1" RadiusY="1" Margin="0,0,2.5,0"/>
                                <Rectangle Width="2" Height="18" Fill="#E6FFFFFF" RadiusX="1" RadiusY="1"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="HandleR" Width="14" Height="58" Background="{StaticResource AccentBg}"
                                CornerRadius="0,5,5,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Width="2" Height="18" Fill="#E6FFFFFF" RadiusX="1" RadiusY="1" Margin="0,0,2.5,0"/>
                                <Rectangle Width="2" Height="18" Fill="#E6FFFFFF" RadiusX="1" RadiusY="1"/>
                            </StackPanel>
                        </Border>
                        <Rectangle x:Name="Playhead" Width="2" Height="58" Fill="#FFF2F3F5">
                            <Rectangle.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6" Color="#FF000000"/>
                            </Rectangle.Effect>
                        </Rectangle>
                        <Ellipse x:Name="PlayheadKnob" Width="9" Height="9" Fill="#FFF2F3F5" Canvas.Top="-1"/>
                        <Border x:Name="TimeBadge" Background="#F2101114" CornerRadius="5" Padding="7,3"
                                BorderBrush="#33FFFFFF" BorderThickness="1" Visibility="Collapsed">
                            <TextBlock x:Name="TimeBadgeText" Foreground="White" FontSize="11.5" FontFamily="Consolas"/>
                        </Border>
                    </Canvas>
                </Grid>
            </Border>

            <!-- transport + save -->
            <Grid Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="PlayBtn" Style="{StaticResource FlatBtn}" Content="▶" Width="46" Click="Play_Click"/>
                    <TextBlock x:Name="TimeLabel" Foreground="{StaticResource TextDim}" FontSize="12.5"
                               FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0,0,0" Text="0:00 / 0:00"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="RangeLabel" Foreground="{StaticResource TextFg}" FontSize="12.5"
                               FontFamily="Consolas" HorizontalAlignment="Center" Text=""/>
                    <TextBlock Foreground="#FF6E747D" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"
                               Text="Drag the blue handles to trim · Space plays · [ and ] set edges at the playhead"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="ReplaceCheck" Content="Replace original" Foreground="{StaticResource TextDim}"
                              FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="SaveBtn" Style="{StaticResource AccentBtn}" Content="Save trimmed"
                            MinWidth="122" Click="SaveTrim_Click"/>
                </StackPanel>
            </Grid>

            <ProgressBar x:Name="TrimProgress" Height="4" Margin="0,12,0,0" Minimum="0" Maximum="1"
                         Visibility="Collapsed" Background="{StaticResource GroupBg}"
                         Foreground="{StaticResource AccentBg}" BorderThickness="0"/>
        </StackPanel>

        <!-- player -->
        <Border Margin="20,16,20,0" Background="Black" CornerRadius="8" ClipToBounds="True"
                BorderBrush="#22FFFFFF" BorderThickness="1">
            <MediaElement x:Name="Player"
                          LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          ScrubbingEnabled="True" Stretch="Uniform"
                          MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"
                          MediaFailed="Player_MediaFailed"
                          MouseLeftButtonUp="Player_Click"/>
        </Border>
    </DockPanel>
</Window>
