<Window x:Class="WinSnipper.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinSnipper — Trim recording"
        Background="#FF1E1F24"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Width="860" Height="620"
        MinWidth="560" MinHeight="420"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        ShowInTaskbar="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="BarBg" Color="#FF24252B"/>
        <SolidColorBrush x:Key="GroupBg" Color="#FF2B2C33"/>
        <SolidColorBrush x:Key="BtnHover" Color="#FF3C3E48"/>
        <SolidColorBrush x:Key="AccentBg" Color="#FF3478F6"/>
        <SolidColorBrush x:Key="AccentHover" Color="#FF4A89F8"/>
        <SolidColorBrush x:Key="TextFg" Color="#FFE8EAEE"/>
        <SolidColorBrush x:Key="TextDim" Color="#FF9AA0A8"/>

        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextFg}"/>
            <Setter Property="Background" Value="{StaticResource GroupBg}"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource BtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Background" Value="{StaticResource AccentBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#E6D64545"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- title bar -->
        <Grid DockPanel.Dock="Top" Background="{StaticResource BarBg}" Height="42">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0">
                <Ellipse Width="10" Height="10" Fill="#FFE5484D" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Text="Trim recording" Foreground="{StaticResource TextFg}" FontSize="13"
                           FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Style="{StaticResource CaptionCloseBtn}" Content="✕" Click="Close_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
        </Grid>

        <!-- footer: trim controls -->
        <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,16">
            <!-- timeline -->
            <Grid Height="34" Margin="0,10,0,0">
                <Border Height="6" VerticalAlignment="Center" Background="{StaticResource GroupBg}" CornerRadius="3"/>
                <Canvas x:Name="RangeCanvas" VerticalAlignment="Stretch" ClipToBounds="False"
                        SizeChanged="RangeCanvas_SizeChanged">
                    <Border x:Name="RangeFill" Height="6" Canvas.Top="14" Background="#803478F6" CornerRadius="3"/>
                    <Rectangle x:Name="StartMarker" Width="3" Height="20" Canvas.Top="7" Fill="#FF53A7FF" RadiusX="1.5" RadiusY="1.5"/>
                    <Rectangle x:Name="EndMarker" Width="3" Height="20" Canvas.Top="7" Fill="#FF53A7FF" RadiusX="1.5" RadiusY="1.5"/>
                </Canvas>
                <Slider x:Name="Seek" VerticalAlignment="Center" Minimum="0" Maximum="1"
                        Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted"
                        ValueChanged="Seek_ValueChanged"/>
            </Grid>

            <!-- transport + trim buttons -->
            <Grid Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="PlayBtn" Style="{StaticResource FlatBtn}" Content="▶" Width="44" Click="Play_Click"/>
                    <TextBlock x:Name="TimeLabel" Foreground="{StaticResource TextDim}" FontSize="12.5"
                               FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0,0,0" Text="0:00 / 0:00"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource FlatBtn}" Content="⇤ Set start" Click="SetStart_Click"
                            ToolTip="Trim start = current position"/>
                    <TextBlock x:Name="RangeLabel" Foreground="{StaticResource TextDim}" FontSize="12.5"
                               FontFamily="Consolas" VerticalAlignment="Center" Margin="10,0" Text=""/>
                    <Button Style="{StaticResource FlatBtn}" Content="Set end ⇥" Click="SetEnd_Click"
                            ToolTip="Trim end = current position"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="ReplaceCheck" Content="Replace original" Foreground="{StaticResource TextDim}"
                              FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="SaveBtn" Style="{StaticResource AccentBtn}" Content="Save trimmed"
                            MinWidth="120" Click="SaveTrim_Click"/>
                </StackPanel>
            </Grid>

            <ProgressBar x:Name="TrimProgress" Height="4" Margin="0,12,0,0" Minimum="0" Maximum="1"
                         Visibility="Collapsed" Background="{StaticResource GroupBg}"
                         Foreground="{StaticResource AccentBg}" BorderThickness="0"/>
        </StackPanel>

        <!-- player -->
        <Border Margin="20,16,20,0" Background="Black" CornerRadius="8" ClipToBounds="True">
            <MediaElement x:Name="Player"
                          LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          ScrubbingEnabled="True" Stretch="Uniform"
                          MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"
                          MediaFailed="Player_MediaFailed"
                          MouseLeftButtonUp="Player_Click"/>
        </Border>
    </DockPanel>
</Window>
